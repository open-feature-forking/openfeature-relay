== SyncFlags, first message, no selector
{
  "flagConfiguration": {
    "json": {
      "flags": {
        "flag-a": {
          "defaultVariant": "on",
          "metadata": {
            "flagSetId": "set-a",
            "owner": "team-a",
            "purpose": "a"
          },
          "source": "<dir>/a.json",
          "state": "ENABLED",
          "variants": {
            "off": false,
            "on": true
          }
        },
        "flag-b": {
          "defaultVariant": "zero",
          "metadata": {
            "flagSetId": "set-b",
            "owner": "team-b"
          },
          "source": "<dir>/b.json",
          "state": "DISABLED",
          "variants": {
            "one": 1,
            "zero": 0
          }
        },
        "shared": {
          "defaultVariant": "red",
          "metadata": {
            "flagSetId": "set-a",
            "owner": "team-a"
          },
          "source": "<dir>/a.json",
          "state": "ENABLED",
          "variants": {
            "blue": "blue",
            "red": "red"
          }
        }
      }
    }
  },
  "syncContext": {}
}
