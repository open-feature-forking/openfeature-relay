SyncServiceHTTPEnabled: true
SyncServiceSocketPath: ""
StreamDeadline: 0s
DisableSyncMetadata: false
StrictNumericRange: false
KeepAliveMinTime: 30s
KeepAlivePermitWithoutStream: true
SyncProviders: []
ConfigurationFormats: []configformat.Factory(nil)
Evaluators: []evaluator.Factory(nil)
SyncFactories: []sync.Factory(nil)
CORS: []string{}
EndpointSettings: map[string]map[string]interface {}(nil)
ContextValues: map[string]interface {}{}
HeaderToContextKeyMappings: map[string]string{}
MaxRequestBodyBytes: 1000000
MaxRequestHeaderBytes: 1000000
Telemetry: otel
TelemetryConfig.caPath: ""
TelemetryConfig.certPath: ""
TelemetryConfig.collectorURI: ""
TelemetryConfig.keyPath: ""
TelemetryConfig.metricsExporter: ""
TelemetryConfig.reloadInterval: 0s

== every flag on the command line
ManagementPort: 9014
OfrepServicePort: 9016
OfrepSSEEnabled: false
OfrepSSEInactivityDel: 77
OfrepSSEPublicURL: "https://cli.example"
ServiceCertPath: "/cli/server.crt"
ServiceKeyPath: "/cli/server.key"
ServicePort: 9013
ServiceSocketPath: "/cli/evaluation.sock"
SyncServicePort: 9015
SyncServiceHTTPEnabled: false
SyncServiceSocketPath: "/cli/sync.sock"
StreamDeadline: 3s
DisableSyncMetadata: true
StrictNumericRange: true
KeepAliveMinTime: 45s
KeepAlivePermitWithoutStream: false
SyncProviders: [{"uri":"/cli/a.json","provider":"file"},{"uri":"/cli/b.json","provider":"file"},{"uri":"cli.example:8015","provider":"grpc","selector":"cli"}]
ConfigurationFormats: []configformat.Factory(nil)
Evaluators: []evaluator.Factory(nil)
SyncFactories: []sync.Factory(nil)
CORS: []string{"https://a.cli", "https://b.cli"}
EndpointSettings: map[string]map[string]interface {}(nil)
ContextValues: map[string]interface {}{"cliKey1":"cliValue1", "cliKey2":"cliValue2"}
HeaderToContextKeyMappings: map[string]string{"X-Cli-A":"cliA", "X-Cli-B":"cliB"}
MaxRequestBodyBytes: 4321
MaxRequestHeaderBytes: 8765
Telemetry: otel
TelemetryConfig.caPath: "/cli/otel-ca.crt"
TelemetryConfig.certPath: "/cli/otel.crt"
TelemetryConfig.collectorURI: "cli-collector:4317"
TelemetryConfig.keyPath: "/cli/otel.key"
TelemetryConfig.metricsExporter: "otel"
TelemetryConfig.reloadInterval: 0s

== every flag as an environment variable
ManagementPort: 10014
OfrepServicePort: 10016
OfrepSSEEnabled: false
OfrepSSEInactivityDel: 88
OfrepSSEPublicURL: "https://env.example"
ServiceCertPath: "/env/server.crt"
ServiceKeyPath: "/env/server.key"
ServicePort: 10013
ServiceSocketPath: "/env/evaluation.sock"
SyncServicePort: 10015
SyncServiceHTTPEnabled: false
SyncServiceSocketPath: "/env/sync.sock"
StreamDeadline: 4s
DisableSyncMetadata: true
StrictNumericRange: true
KeepAliveMinTime: 46s
KeepAlivePermitWithoutStream: false
SyncProviders: [{"uri":"/env/a.json","provider":"file"},{"uri":"/env/b.json","provider":"file"},{"uri":"env.example:8015","provider":"grpc","selector":"env"}]
ConfigurationFormats: []configformat.Factory(nil)
Evaluators: []evaluator.Factory(nil)
SyncFactories: []sync.Factory(nil)
CORS: []string{"https://a.env", "https://b.env"}
EndpointSettings: map[string]map[string]interface {}(nil)
ContextValues: map[string]interface {}{"envKey1":"envValue1"}
HeaderToContextKeyMappings: map[string]string{"X-Env-A":"envA"}
MaxRequestBodyBytes: 5432
MaxRequestHeaderBytes: 9876
Telemetry: otel
TelemetryConfig.caPath: "/env/otel-ca.crt"
TelemetryConfig.certPath: "/env/otel.crt"
TelemetryConfig.collectorURI: "env-collector:4317"
TelemetryConfig.keyPath: "/env/otel.key"
TelemetryConfig.metricsExporter: "otel"
TelemetryConfig.reloadInterval: 3h0m0s

